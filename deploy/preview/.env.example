# The settings of the preview on the home server. Copy this file to .env and fill it in. Never commit the .env.

# The one email that gets a login code for the studio app (Nina).
STUDIO_EMAIL=
# The public address of the preview, for example https://preview.tumach.dance
BETTER_AUTH_URL=
# A long random secret, only for the preview: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The Mailgun key and domain of the preview (the preview sends email only to Nina and Lars).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# An EU account: https://api.eu.mailgun.net
MAILGUN_API_URL=https://api.mailgun.net
# The site of this server: the preview shows the "test site" banner.
SITE_ENV=preview
# The token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > Docker command).
TUNNEL_TOKEN=
