# The settings of the live site (tumach.dance) on the home server. Copy this file to .env and fill it in with new
# values: never copy the .env of the preview. Never commit the .env. The compose file sets SITE_ENV=live.

# The one email that gets a login code for the studio app (Nina).
STUDIO_EMAIL=
# The public address of the live site.
BETTER_AUTH_URL=https://tumach.dance
# A long random secret, only for the live site: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The Mailgun key and domain of the live site.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# An EU account: https://api.eu.mailgun.net
MAILGUN_API_URL=https://api.mailgun.net
# The push keys of the live site: `npx web-push generate-vapid-keys`. VAPID_SUBJECT: mailto:hello@tumach.dance
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The token of the live Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > Docker command).
TUNNEL_TOKEN=
