# The settings of the server, one .env per site (preview and live have their own values). Never commit the .env.

# The SQLite database (the image sets /data/tumach.db).
DATABASE_PATH=./data/tumach.db

# The login of the studio app (#19). STUDIO_EMAIL: the one email that gets a login code (Nina).
STUDIO_EMAIL=
# The address of the site, for example https://tumach.dance (https: the session cookie is Secure).
BETTER_AUTH_URL=http://localhost:3000
# A long random secret: `openssl rand -base64 32`. Each site has its own.
BETTER_AUTH_SECRET=

# Email through the Mailgun HTTP API. With no key, development writes each email to the server log; the
# production server refuses to send a login code (EMAIL_TRANSPORT=log allows the log, only for tests).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# An EU account: https://api.eu.mailgun.net
MAILGUN_API_URL=https://api.mailgun.net
# Default: TUMACH <hello@MAILGUN_DOMAIN>
EMAIL_FROM=
